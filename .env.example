# Server Port
PORT=3000

# Environment (development | production)
NODE_ENV=production

# Master Admin Key for Dashboard actions (optional, defaults to auto-generated)
ADMIN_KEY=your_secure_admin_key_here

# Default OTP Expiration (in minutes)
DEFAULT_OTP_EXPIRY_MINUTES=5

# Rate Limit: Maximum OTP requests per phone number within window (in minutes)
RATE_LIMIT_MAX_PER_PHONE=4
RATE_LIMIT_WINDOW_MINUTES=10
